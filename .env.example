# Carepath Environment Configuration

# Server Port (defaults to 3000 locally; cloud hosts like Render/Railway set this automatically)
PORT=3000

# Environment mode: development | production
NODE_ENV=development

# Session secret for tamper-proof session tokens
# Leave blank to auto-generate a persistent secret in .carepath-data/session.secret, or provide a random string
SESSION_SECRET=

# AI Provider Configuration
# Set your OpenAI API key to enable AI-powered chat responses
# Leave blank to run with local algorithmic guidance (zero external API dependency)
OPENAI_API_KEY=

# Model selection (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI-compatible base URL (e.g. https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
